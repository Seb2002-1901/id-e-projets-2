# LUCIDE — variables d'environnement
# Copie : cp .env.example .env  — .env est gitignored, JAMAIS commité.
# Préfixe EXPO_PUBLIC_ = embarqué dans l'app (public par nature — aucun secret ici).

# --- App (client) ---
APP_ENV=development                     # development | staging | production
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=          # clé anon (publique, RLS fait la sécurité)
EXPO_PUBLIC_POSTHOG_KEY=                # projet EU
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_CONTENT_MANIFEST_URL=https://content.lucide.app/manifest.json
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=       # clé publique RC

# --- Serveur (Edge Functions / CI uniquement — via Supabase Vault & GitHub Secrets) ---
SUPABASE_SERVICE_ROLE_KEY=              # JAMAIS côté client
RC_WEBHOOK_SECRET=                      # vérification signature RevenueCat
EXPO_PUSH_ACCESS_TOKEN=                 # envoi N3/N4
EXPORT_MAIL_FROM=export@lucide.app
CONTENT_SIGNING_KEY=                    # signature du manifest corpus

# --- CI ---
EXPO_TOKEN=                             # EAS
SENTRY_AUTH_TOKEN=                      # upload sourcemaps (release only)
