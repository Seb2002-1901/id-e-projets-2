{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@lucide/shared": [
        "../../packages/shared/src/index.ts"
      ]
    }
  },
  "include": [
    "app",
    "src",
    "test",
    "app.config.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "e2e"
  ]
}